---
import ContributionGraph from '../components/contribution-graph.astro'
import { site } from '../site'

const link = 'underline decoration-underline decoration-1 underline-offset-4 transition-[text-decoration-color] duration-150 hover:decoration-current'
---

<section class='flex flex-col gap-6 px-inset' aria-labelledby='headline'>
  <div class='flex flex-col gap-3'>
    <h1 id='headline' class='text-h1 font-medium tracking-display text-balance mobile:text-h1-sm'>
      {site.headline}
    </h1>
    <p class='text-pretty text-muted-foreground'>{site.about}</p>
  </div>

  <ContributionGraph />

  <ul class='flex flex-wrap gap-x-4.5 gap-y-2 text-link mobile:gap-x-4' aria-label='Contact'>
    <li>
      <a class={link} href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </li>
    {site.links.map((item) => (
      <li>
        <a class={link} href={item.href} target='_blank' rel='me noopener'>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</section>
