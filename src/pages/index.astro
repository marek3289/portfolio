---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Intro from "../components/Intro.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Footer from "../components/Footer.astro";
import Toast from "../components/Toast.astro";
import { nowProjects, shippedProjects, stats } from "../data/projects";
---

<Base>
  <div class="page">
    <Header />
    <main class="main">
      <Intro />
      <div class="projects">
        <ProjectSection id="now" label="Now" projects={nowProjects} />
        <ProjectSection id="shipped" label="Shipped" projects={shippedProjects} />
      </div>
      <p class="stats">
        {stats.total} projects · {stats.shipped} shipped · {stats.failed} failed · {stats.inProgress} in progress
      </p>
    </main>
    <Footer />
  </div>
  <Toast />
</Base>

<style>
  .main,
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--gap-block);
  }

  .stats {
    padding-inline: var(--inset);
    font-size: var(--text-link);
    line-height: var(--leading-link);
  }
</style>
