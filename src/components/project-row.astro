---
import ArrowUpRight from './arrow-up-right.astro'
import type { Project } from '@/types'

interface Props {
  project: Project
}

const { project } = Astro.props
const live = project.status === 'now'
const sunset = project.status === 'sunset'
const href = sunset ? undefined : project.url
const Tag = href ? 'a' : 'div'
const linkProps = href ? { href, target: '_blank', rel: 'noopener' } : {}
---

<li>
  <Tag
    class:list={[
      'group relative flex items-center gap-4 rounded-row px-inset py-2.5 text-row transition-colors duration-150',
      'mobile:flex-wrap mobile:items-baseline mobile:gap-x-2 mobile:gap-y-0.5 mobile:py-3',
      href && 'pointer-fine:hover:bg-accent',
    ]}
    {...linkProps}
  >
    {live && <span class='absolute top-4.5 left-1.5 size-1.5 rounded-full bg-live mobile:top-5' aria-hidden='true' />}
    <span class='flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 mobile:contents'>
      <span class:list={['font-medium whitespace-nowrap mobile:order-1 mobile:basis-full', sunset && 'text-muted-foreground']}>
        {project.name}
        {href && <ArrowUpRight />}
        {href && <span class='sr-only'>(opens in a new tab)</span>}
        {live && <span class='sr-only'>(in progress)</span>}
      </span>
      <span class='text-muted-foreground mobile:order-2 mobile:basis-full mobile:text-desc'>{project.description}</span>
      {project.metric && (
        <span class="font-mono text-meta whitespace-nowrap text-muted-foreground mobile:order-4 mobile:leading-5.5 mobile:before:content-['·_']">
          {project.metric}
        </span>
      )}
      {sunset && (
        <span class="font-mono text-meta tracking-tag whitespace-nowrap text-muted-foreground uppercase mobile:order-4 mobile:leading-[22px] mobile:before:content-['·_']">
          Sunset
        </span>
      )}
    </span>
    <span class='shrink-0 text-right font-mono text-[12px] leading-5.5 whitespace-nowrap text-muted-foreground mobile:order-3 mobile:pt-0.5 mobile:text-left'>
      {project.type} · {project.year}
    </span>
  </Tag>
</li>
