---
import { site } from "../data/site";
---

<header class="header">
  <a class="brand" href="/" aria-label={`${site.handle}, home`}>
    <span class="mark" aria-hidden="true">{site.monogram}</span>
    <span>{site.handle}</span>
  </a>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    padding-inline: var(--inset);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    line-height: 20px;
  }

  .mark {
    display: grid;
    place-items: center;
    width: var(--mark-size);
    height: var(--mark-size);
    flex-shrink: 0;
    border-radius: var(--radius-mark);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
    line-height: 16px;
    letter-spacing: var(--tracking-mark);
  }
</style>
