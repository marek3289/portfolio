---
import { site } from "../data/site";

const updated = site.updated.toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---

<footer class="footer mono" data-email={site.email} data-time-zone={site.timeZone}>
  <span>Updated {updated}</span>
  <time class="clock" data-clock></time>
  <span class="hint" data-copy-hint>
    Press <kbd>C</kbd> to copy email
  </span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    padding: 20px var(--inset) 0;
    border-top: 1px solid var(--color-divider);
    line-height: var(--leading-meta);
  }

  /* Reserve the clock's width so filling it in doesn't shift the hint. */
  .clock {
    min-width: 9ch;
    font-variant-numeric: tabular-nums;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  kbd {
    padding: 1px 5px;
    border: 1px solid var(--color-kbd-border);
    border-radius: var(--radius-kbd);
    font-family: var(--font-mono);
    font-size: var(--text-kbd);
    font-weight: 500;
    line-height: 14px;
    color: var(--color-text);
  }

  /* No physical keyboard: hide the hint. */
  @media (max-width: 640px), (hover: none) {
    .hint {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .footer {
      gap: 6px 16px;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>(".footer");

  if (footer) {
    const { email = "", timeZone } = footer.dataset;

    // Local clock, e.g. "14:32 CET". Updates on the minute.
    const clock = footer.querySelector<HTMLTimeElement>("[data-clock]");
    if (clock) {
      const format = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        timeZone,
        timeZoneName: "short",
      });
      const tick = () => {
        const now = new Date();
        clock.textContent = format.format(now);
        clock.dateTime = now.toISOString();
      };
      tick();
      setTimeout(() => {
        tick();
        setInterval(tick, 60_000);
      }, 60_000 - (Date.now() % 60_000));
    }

    // Press C to copy the email address.
    const isTyping = (target: EventTarget | null) =>
      target instanceof HTMLElement &&
      (target.isContentEditable || target.closest("input, textarea, select") !== null);

    document.addEventListener("keydown", async (event) => {
      if (event.key.toLowerCase() !== "c" || event.repeat) return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      if (isTyping(event.target)) return;

      let detail = { message: "Email copied", ok: true };
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // Clipboard blocked: at least show the address so it can be copied by hand.
        detail = { message: email, ok: false };
      }
      document.dispatchEvent(new CustomEvent("toast", { detail }));
    });
  }
</script>
