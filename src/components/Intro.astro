---
import { site } from "../data/site";
---

<section class="intro" id="about" aria-labelledby="headline">
  <div class="copy">
    <h1 id="headline">{site.headline}</h1>
    <p class="about">{site.about}</p>
    <p class="goal">{site.currentGoal}</p>
  </div>

  <ul class="contact" id="contact" aria-label="Contact">
    <li><a class="underline" href={`mailto:${site.email}`}>{site.email}</a></li>
    {
      site.links.map((link) => (
        <li>
          <a class="underline" href={link.href} target="_blank" rel="me noopener">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-inline: var(--inset);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: 500;
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-h1);
    text-wrap: balance;
  }

  .about {
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: var(--text-link);
    line-height: var(--leading-link);
  }

  @media (max-width: 640px) {
    .contact {
      column-gap: 16px;
    }
  }
</style>
